        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…… 後面還有 %@ 列未在此顯示。\n拷貝與分享包含全部內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…… 여기서부터 %@줄은 화면에 표시하지 않았습니다.\n복사와 공유에는 전부 들어 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…… hay %@ líneas más que no se muestran aquí.\nCopiar y Compartir las incluyen todas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…… %@ lignes supplémentaires ne sont pas affichées ici.\nCopier et Partager les incluent toutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…… %@ weitere Zeilen werden hier nicht angezeigt.\nKopieren und Teilen enthalten alles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…… ci sono altre %@ righe non mostrate qui.\nCopia e Condividi le includono tutte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…… há mais %@ linhas que não aparecem aqui.\nCopiar e Compartilhar incluem tudo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…… ещё %@ строк здесь не показаны.\nВ «Скопировать» и «Поделиться» входит всё."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n…… هناك %@ سطراً إضافياً لا تظهر هنا.\nالنسخ والمشاركة يتضمّنان كل شيء."
          }
        }
      }
    },
