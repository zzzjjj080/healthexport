{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "ヘルスケア書き出し": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health for AI"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケア書き出し"
          }
        }
      }
    },
    "期間": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Period"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間"
          }
        }
      }
    },
    "日付で指定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick dates"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付で指定"
          }
        }
      }
    },
    "書き出されるデータ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What gets exported"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出されるデータ"
          }
        }
      }
    },
    "項目や形式を変える": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change metrics or format"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目や形式を変える"
          }
        }
      }
    },
    "AIへの依頼文がつきます": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A request for the AI is included"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIへの依頼文がつきます"
          }
        }
      }
    },
    "記録が1件も見つかりませんでした": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No records found"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録が1件も見つかりませんでした"
          }
        }
      }
    },
    "この期間に記録が無いか、ヘルスケアの読み取りが許可されていない可能性があります。「設定」→「プライバシーとセキュリティ」→「ヘルスケア」→「ヘルスケア書き出し」で、読み取りがオンになっているか確かめてください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either there are no records in this period, or Health access hasn't been granted. Check Settings → Privacy & Security → Health → Health Export and make sure reading is on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間に記録が無いか、ヘルスケアの読み取りが許可されていない可能性があります。「設定」→「プライバシーとセキュリティ」→「ヘルスケア」→「ヘルスケア書き出し」で、読み取りがオンになっているか確かめてください。"
          }
        }
      }
    },
    "設定アプリを開く": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定アプリを開く"
          }
        }
      }
    },
    "閉じる": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "書き出す": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出す"
          }
        }
      }
    },
    "まずはこれ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start here"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずはこれ"
          }
        }
      }
    },
    "書き出したもの": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exported text"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出したもの"
          }
        }
      }
    },
    "共有": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有"
          }
        }
      }
    },
    "チャット欄に貼るなら「コピー」、ファイルで送るなら「共有」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy to paste into a chat, or Share to send it as a file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット欄に貼るなら「コピー」、ファイルで送るなら「共有」。"
          }
        }
      }
    },
    "項目": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metrics"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目"
          }
        }
      }
    },
    "形式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
