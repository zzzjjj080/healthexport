    "書き出せる項目がありません。ヘルスケアの許可と、選んでいる期間を確かめてください。": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出せる項目がありません。ヘルスケアの許可と、選んでいる期間を確かめてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to export. Check Health access and the selected period."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可导出的项目。请确认“健康”权限和所选时间范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可匯出的項目。請確認「健康」權限和所選時間範圍。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낼 항목이 없습니다. 건강 접근 권한과 선택한 기간을 확인해 주세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que exportar. Comprueba el acceso a Salud y el periodo seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à exporter. Vérifiez l'accès à Santé et la période sélectionnée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu exportieren. Prüfe den Health-Zugriff und den gewählten Zeitraum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da esportare. Controlla l'accesso a Salute e il periodo selezionato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada a exportar. Verifique o acesso à Saúde e o período selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выгружать нечего. Проверьте доступ к «Здоровью» и выбранный период."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ما يُصدَّر. تحقق من الوصول إلى «الصحة» ومن الفترة المختارة."
          }
        }
      }
    },
