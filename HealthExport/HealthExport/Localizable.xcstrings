          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形式"
          }
        }
      }
    },
    "詳しい設定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detailed settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
