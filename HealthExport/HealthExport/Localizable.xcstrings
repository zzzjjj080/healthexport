    "チャット欄に貼るなら「コピー」、ファイルで送るなら「共有」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy to paste into a chat, or Share to send it as a file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット欄に貼るなら「コピー」、ファイルで送るなら「共有」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴到聊天框请用“拷贝”，以文件发送请用“共享”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼到聊天欄請用「拷貝」，以檔案傳送請用「分享」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅창에 붙여넣으려면 '복사', 파일로 보내려면 '공유'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia para pegarlo en un chat, o comparte para enviarlo como archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez pour coller dans une conversation, ou partagez pour envoyer un fichier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Einfügen in einen Chat „Kopieren“, zum Senden als Datei „Teilen“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia per incollarlo in una chat, oppure condividi per inviarlo come file."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie para colar em um chat, ou compartilhe para enviar como arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Скопировать» — чтобы вставить в чат, «Поделиться» — чтобы отправить файлом."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ للصقه في محادثة، أو شارك لإرساله كملف."
          }
        }
      }
    },
