          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        }
      }
    },
    "目的にまかせる": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset to purpose"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目的にまかせる"
          }
        }
      }
    },
    "直近": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近"
          }
        }
      }
    },
    "はじめ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめ"
          }
        }
      }
    },
    "おわり": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おわり"
          }
        }
      }
    },
    "日付の指定をやめる": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear dates"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付の指定をやめる"
          }
        }
      }
    },
    "日付を選ぶと、上の「直近」より優先されます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picked dates take priority over the presets above."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付を選ぶと、上の「直近」より優先されます。"
          }
        }
      }
    },
    "この期間に記録があった項目だけを出しています。チェックを外すと書き出しから抜けます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only metrics with records in this period are listed. Uncheck one to leave it out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間に記録があった項目だけを出しています。チェックを外すと書き出しから抜けます。"
          }
        }
      }
    },
    "ヘルスケアの許可をもう一度求める": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask for Health access again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアの許可をもう一度求める"
          }
        }
      }
    },
    "最初に「許可しない」を選んだ場合、この操作では画面が出ないことがあります。そのときは設定アプリから変えてください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you chose Don't Allow the first time, this may not show a prompt. Change it in the Settings app instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初に「許可しない」を選んだ場合、この操作では画面が出ないことがあります。そのときは設定アプリから変えてください。"
          }
        }
      }
    },
    "この期間に記録が無かった項目": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metrics with no records in this period"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間に記録が無かった項目"
          }
        }
      }
    },
    "持っている端末で測れないもののほか、ヘルスケアの読み取りが許可されていない場合もここに入ります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This includes things your devices can't measure, and anything Health access hasn't been granted for."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "持っている端末で測れないもののほか、ヘルスケアの読み取りが許可されていない場合もここに入ります。"
          }
        }
      }
    },
    "まとめ方": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detail"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まとめ方"
          }
        }
      }
    },
    "1日ごとにまとめる（おすすめ）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One row per day (recommended)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日ごとにまとめる（おすすめ）"
