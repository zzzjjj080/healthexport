            "value": "Comma"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンマ"
          }
        }
      }
    },
    "見やすく揃える": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligned columns"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見やすく揃える"
          }
        }
      }
    },
    "列名を英字の略称にする": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short column names"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "列名を英字の略称にする"
          }
        }
      }
    },
    "先頭の説明文": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Header notes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先頭の説明文"
          }
        }
      }
    },
    "くわしく": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "くわしく"
          }
        }
      }
    },
    "最小限": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最小限"
          }
        }
      }
    },
    "なし": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なし"
          }
        }
      }
    },
    "記録が無い日は行ごと省く": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip days with no records"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録が無い日は行ごと省く"
          }
        }
      }
    },
    "説明文には「値は重複を除いたあとの数字」「空欄は記録が無いという意味で、0ではない」という断りが入ります。AIの読み違いを防ぐためのものなので、残しておくのがおすすめです。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The header explains that values are deduplicated and that a blank means no record, not zero. It keeps the AI from misreading the data, so leaving it on is recommended."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明文には「値は重複を除いたあとの数字」「空欄は記録が無いという意味で、0ではない」という断りが入ります。AIの読み違いを防ぐためのものなので、残しておくのがおすすめです。"
          }
        }
      }
    },
    "ヘルスケアの記録を、\nAIに渡せる文章に。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your Health records\ninto text an AI can read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアの記録を、\nAIに渡せる文章に。"
          }
        }
      }
    },
    "目的を選ぶ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a purpose"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目的を選ぶ"
          }
        }
      }
    },
    "期間も項目も、AIへの依頼文も、それだけで決まります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That alone sets the period, the metrics, and the request for the AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間も項目も、AIへの依頼文も、それだけで決まります。"
          }
        }
      }
    },
    "ヘルスケアから読んで、1枚のテキストにまとめます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads from Health and builds one text file."
