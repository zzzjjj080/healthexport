    "期間も項目も、AIへの依頼文も、それだけで決まります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That alone sets the period, the metrics, and the request for the AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間も項目も、AIへの依頼文も、それだけで決まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间范围、项目和给 AI 的提问，都会随之确定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時間範圍、項目和給 AI 的提問，都會隨之確定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
