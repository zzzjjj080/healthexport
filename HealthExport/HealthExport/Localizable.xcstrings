      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metric (km, kg)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メートル法（km・kg）"
          }
        }
      }
    },
    "ヤード・ポンド法（mi・lb）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "US (mi, lb)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヤード・ポンド法（mi・lb）"
          }
        }
      }
    },
    "AIへの依頼文を付ける": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include a request for the AI"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIへの依頼文を付ける"
          }
        }
      }
    },
    "依頼文": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request text"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼文"
          }
        }
      }
    },
    "目的を変えると内容も変わります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes with the purpose you pick."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目的を変えると内容も変わります。"
          }
        }
      }
    },
    "端末の名前を入れる": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include device names"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の名前を入れる"
          }
        }
      }
    },
    "ヘルスケアの端末名は「〇〇のApple Watch」のように、名前が入っていることがあります。渡す相手によっては外してください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device names in Health often contain your own name (e.g. “Jin's Apple Watch”). Turn this off if that matters for who you're sending it to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアの端末名は「〇〇のApple Watch」のように、名前が入っていることがあります。渡す相手によっては外してください。"
          }
        }
      }
    },
    "表のかたち": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Table layout"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表のかたち"
          }
        }
      }
    },
    "並べ方": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layout"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並べ方"
          }
        }
      }
    },
    "日付でそろえた1枚の表": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One table by date"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付でそろえた1枚の表"
          }
        }
      }
    },
    "項目ごとに分ける": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One table per metric"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目ごとに分ける"
          }
        }
      }
    },
    "列の区切り": {
      "localizations": {
        "en": {
          "stringUnit": {
